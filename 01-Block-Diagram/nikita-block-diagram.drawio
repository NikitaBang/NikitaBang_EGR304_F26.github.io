<mxfile host="app.diagrams.net"><diagram name="Main Control Board" id="mainbd"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="960" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b11" value="&lt;b style='font-size:20px'&gt;Block Diagram -- Team 201: Fill-A-Bot&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;Nikita Bangiyev - Main Control Board&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=default;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="200" y="10" width="1100" height="56" as="geometry"/></mxCell><mxCell id="b12" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=default;strokeWidth=2;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="225" y="95" width="1065" height="655" as="geometry"/></mxCell><mxCell id="b13" value="&lt;b&gt;Main Control Board (my PCB)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=default;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry x="235" y="100" width="300" height="24" as="geometry"/></mxCell><mxCell id="b14" value="&lt;b&gt;Wall adapter&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;9V 2A, off-board&lt;br&gt;Triad WSU090-2000&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;fillColor=default;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=default;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="150" height="80" as="geometry"/></mxCell><mxCell id="b15" value="&lt;b&gt;Power&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Barrel jack -&gt; T800mA fuse -&gt; 5V regulator&lt;br&gt;LM1086IT-5.0 with heat sink&lt;br&gt;9V and 5V power LEDs&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;fillColor=default;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=default;" vertex="1" parent="1"><mxGeometry x="265" y="140" width="300" height="100" as="geometry"/></mxCell><mxCell id="b16" value="9V DC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.4;strokeColor=#CC0000;fontSize=11;labelBackgroundColor=default;fontFamily=Helvetica;fontColor=#CC0000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b14" target="b15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b17" value="&lt;b&gt;Microcontroller&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;PIC18F57Q43 Curiosity Nano&lt;br&gt;runs the fill sequence&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;fillColor=default;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=default;" vertex="1" parent="1"><mxGeometry x="640" y="320" width="260" height="170" as="geometry"/></mxCell><mxCell id="b18" value="+5V to every block" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.4;strokeColor=#CC0000;fontSize=11;labelBackgroundColor=default;fontFamily=Helvetica;fontColor=#CC0000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b15" target="b17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="190"/></Array></mxGeometry></mxCell><mxCell id="b19" value="&lt;b&gt;Buttons&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;UP, DOWN, START, STOP&lt;br&gt;pull-ups and RC debounce&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;fillColor=default;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=default;" vertex="1" parent="1"><mxGeometry x="265" y="300" width="260" height="70" as="geometry"/></mxCell><mxCell id="b20" value="&lt;b&gt;Cup Sensor&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;photoresistor -&gt; op amp (buffer, gain)&lt;br&gt;-&gt; low-pass filter&lt;br&gt;PDV-P8103 + MCP6002&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;fillColor=default;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=default;" vertex="1" parent="1"><mxGeometry x="265" y="395" width="260" height="95" as="geometry"/></mxCell><mxCell id="b21" value="&lt;b&gt;Debug&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;button and LED&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;fillColor=default;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=default;" vertex="1" parent="1"><mxGeometry x="265" y="520" width="260" height="55" as="geometry"/></mxCell><mxCell id="b22" value="Digital in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=default;fontSize=11;labelBackgroundColor=default;fontFamily=Helvetica;fontColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.0882;entryDx=0;entryDy=0;" edge="1" parent="1" source="b19" target="b17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b23" value="Analog in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=default;fontSize=11;labelBackgroundColor=default;fontFamily=Helvetica;fontColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7206;entryDx=0;entryDy=0;" edge="1" parent="1" source="b20" target="b17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b24" value="Digital in / out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=default;fontSize=11;labelBackgroundColor=default;fontFamily=Helvetica;fontColor=default;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="b21" target="b17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="547"/><mxPoint x="600" y="473"/></Array></mxGeometry></mxCell><mxCell id="b25" value="&lt;b&gt;16x2 LCD&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;shows the amount and status&lt;br&gt;NHD-0216K1Z-FL-YBW&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;fillColor=default;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=default;" vertex="1" parent="1"><mxGeometry x="1005" y="300" width="255" height="70" as="geometry"/></mxCell><mxCell id="b26" value="&lt;b&gt;Status LEDs&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Dispensing, Done, Fault&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;fillColor=default;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=default;" vertex="1" parent="1"><mxGeometry x="1005" y="395" width="255" height="60" as="geometry"/></mxCell><mxCell id="b27" value="&lt;b&gt;Expansion Headers&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;spare pins for fixes&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;fillColor=default;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=default;" vertex="1" parent="1"><mxGeometry x="1005" y="480" width="255" height="60" as="geometry"/></mxCell><mxCell id="b28" value="4-bit parallel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=default;fontSize=11;labelBackgroundColor=default;fontFamily=Helvetica;fontColor=default;exitX=1;exitY=0.0882;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b17" target="b25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b29" value="Digital out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=default;fontSize=11;labelBackgroundColor=default;fontFamily=Helvetica;fontColor=default;exitX=1;exitY=0.6176;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b17" target="b26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b30" value="Digital in / out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=default;fontSize=11;labelBackgroundColor=default;fontFamily=Helvetica;fontColor=default;startArrow=block;startFill=1;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b17" target="b27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="464"/><mxPoint x="950" y="510"/></Array></mxGeometry></mxCell><mxCell id="b31" value="&lt;b&gt;Ribbon Headers (J1, J2, J3)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;8-wire ribbon to each teammate, pin 8 GND, no power&lt;br&gt;Wurth 61200821621&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;fillColor=default;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=default;" vertex="1" parent="1"><mxGeometry x="590" y="615" width="360" height="80" as="geometry"/></mxCell><mxCell id="b32" value="2-bit commands out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=default;fontSize=11;labelBackgroundColor=default;fontFamily=Helvetica;fontColor=default;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3556;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b17" target="b31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b33" value="2-bit status in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=default;fontSize=11;labelBackgroundColor=default;fontFamily=Helvetica;fontColor=default;exitX=0.6389;exitY=0;exitDx=0;exitDy=0;entryX=0.6923;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b31" target="b17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b34" value="&lt;b&gt;Cole: Flow Sensing board&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;off-board&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;fillColor=default;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=default;" vertex="1" parent="1"><mxGeometry x="300" y="815" width="260" height="60" as="geometry"/></mxCell><mxCell id="b35" value="&lt;b&gt;Clay: Pump Control board&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;off-board&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;fillColor=default;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=default;" vertex="1" parent="1"><mxGeometry x="640" y="815" width="260" height="60" as="geometry"/></mxCell><mxCell id="b36" value="&lt;b&gt;Troy: Liquid Amount board&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;off-board&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;fillColor=default;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=default;" vertex="1" parent="1"><mxGeometry x="980" y="815" width="260" height="60" as="geometry"/></mxCell><mxCell id="b37" value="flow status (2-bit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=default;fontSize=11;labelBackgroundColor=default;fontFamily=Helvetica;fontColor=default;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b34" target="b31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="780"/><mxPoint x="626" y="780"/></Array></mxGeometry></mxCell><mxCell id="b38" value="pump command (2-bit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=default;fontSize=11;labelBackgroundColor=default;fontFamily=Helvetica;fontColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b31" target="b35"><mxGeometry x="0.45" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b39" value="preset (2-bit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=default;fontSize=11;labelBackgroundColor=default;fontFamily=Helvetica;fontColor=default;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b31" target="b36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="878" y="790"/><mxPoint x="1045" y="790"/></Array></mxGeometry></mxCell><mxCell id="b40" value="weight status (2-bit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=default;fontSize=11;labelBackgroundColor=default;fontFamily=Helvetica;fontColor=default;exitX=0.65;exitY=0;exitDx=0;exitDy=0;entryX=0.9;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b36" target="b31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1149" y="770"/><mxPoint x="914" y="770"/></Array></mxGeometry></mxCell><mxCell id="b41" value="&lt;b&gt;Legend:&lt;/b&gt; red arrow = power, black arrow = signal, the arrowhead shows the direction. 2-bit = 2 plain digital wires with 4 states (00, 01, 10, 11), and 00 is the safe default. No UART or I2C between boards. Each board has its own adapter and regulator." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=default;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="895" width="1260" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>