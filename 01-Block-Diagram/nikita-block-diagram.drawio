=11;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="990" width="224" height="60" as="geometry"/></mxCell><mxCell id="j2_team" value="&lt;b&gt;Clay Belsher: Pump Control board&lt;/b&gt;&lt;br&gt;(off-board) Curiosity Nano&lt;br&gt;pump command in on pins 1-2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="752" y="990" width="224" height="60" as="geometry"/></mxCell><mxCell id="j3_team" value="&lt;b&gt;Troy Reynolds: Liquid Amount board&lt;/b&gt;&lt;br&gt;(off-board) Curiosity Nano&lt;br&gt;command in 1-2, status out 3-4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1034" y="990" width="224" height="60" as="geometry"/></mxCell><mxCell id="e27" value="8-wire ribbon cable&lt;br&gt;Digital - Parallel (5VDC, 2 pins)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontFamily=Helvetica;endArrow=classic;endFill=1;strokeWidth=1.3;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontSize=9;" edge="1" parent="1" source="j1_team" target="j1_name"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="8-wire ribbon cable&lt;br&gt;Digital - Parallel (5VDC, 2 pins)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontFamily=Helvetica;endArrow=classic;endFill=1;strokeWidth=1.3;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=9;" edge="1" parent="1" source="j2_name" target="j2_team"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e29" value="command&lt;br&gt;(5VDC, 2 pins)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontFamily=Helvetica;endArrow=classic;endFill=1;strokeWidth=1.3;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.25;entryY=0;fontSize=9;" edge="1" parent="1" source="j3_name" target="j3_team"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e30" value="status&lt;br&gt;(5VDC, 2 pins)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontFamily=Helvetica;endArrow=classic;endFill=1;strokeWidth=1.3;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;entryX=0.75;entryY=1;fontSize=9;" edge="1" parent="1" source="j3_team" target="j3_name"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notes" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;Dashed boxes are the power supplies. U2 sits on both because it uses 9V in and 5V out.&lt;br&gt;Pin counts are signal pins only, not power or ground.&lt;br&gt;Ribbon: pins 1-2 main out, 3-4 teammate out, 5-7 not used, 8 GND, no power pin. Each signal is 2 wires = 4 states, 00 is the safe default. 100k pull-downs on my inputs.&lt;br&gt;&lt;b&gt;Codes&lt;/b&gt;&lt;br&gt;Pump: 00 stop, 01 run, 10/11 stop&lt;br&gt;Weight cmd: preset 1-4 = 00, 01, 10, 11&lt;br&gt;Weight status: 00 not ready, 01 below target, 10 reached, 11 error&lt;br&gt;Flow: 00 no flow, 01 flowing, 10 no flow, 11 fault" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1300" y="905" width="280" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>